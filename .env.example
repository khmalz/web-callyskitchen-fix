# Calls Kitchen Environment Variables

# Supabase Configuration
# Project URL provided for Calls Kitchen:
VITE_SUPABASE_URL=https://icnbtgkzzocjgjosenca.supabase.co
# Masukkan anon/public key dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Payment Gateway Configuration (Midtrans / QRIS Dynamic Provider)
# PERINGATAN KEAMANAN: Secret Key gateway TIDAK BOLEH diletakkan di frontend (VITE_*)!
# Secret Key hanya boleh disimpan di Supabase Edge Function Secrets atau backend tepercaya.
VITE_PAYMENT_GATEWAY_CLIENT_KEY=
VITE_PAYMENT_ENVIRONMENT=sandbox # 'sandbox' atau 'production'
